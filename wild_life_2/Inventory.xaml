<Window x:Class="wild_life_2.Inventory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wild_life_2"
        mc:Ignorable="d"
        Title="Inventory" Height="450" Width="800">
    <Grid Background="BurlyWood">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- LINKERKANT INVENTARIS -->
        <Border Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="2"
                Margin="10">

            <UniformGrid x:Name="InventoryGrid"
                         Columns="5"
                         Margin="10">

                <Button Content="🍎"
                        Click="InventoryItem_Click"/>

                <Button Content=""
                        IsEnabled="False"/>

                <Button Content=""
                        IsEnabled="False"/>

            </UniformGrid>

        </Border>


        <!-- RECHTERKANT ITEM DETAILS -->
        <Grid Grid.Column="1"
              Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Naam -->
            <Border Grid.Row="0"
                    BorderBrush="Black"
                    BorderThickness="2"
                    Margin="5">

                <TextBlock x:Name="ItemNameText"
                           Text="Selecteer een item"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Info -->
            <Border Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="2"
                    Margin="5">

                <TextBlock x:Name="ItemInfoText"
                           TextWrapping="Wrap"
                           FontSize="18"
                           Margin="10"/>
            </Border>

            <!-- Actie knop -->
            <Button Grid.Row="2"
                    x:Name="EatButton"
                    Content="Eten"
                    FontSize="20"
                    Margin="5"
                    IsEnabled="False"
                    Click="EatButton_Click"/>

        </Grid>

    </Grid>
</Window>
